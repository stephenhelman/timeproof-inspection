# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://your-domain.com

# Resend (email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# App
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# GoHighLevel (legacy GHL sync)
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_PIPELINE_ID_REVIVAL=
GHL_PIPELINE_ID_DIALER=
GHL_WEBHOOK_SECRET=

# Anthropic (Claude bot)
ANTHROPIC_API_KEY=sk-ant-...

# Qntum Roofing — Terros inbound webhook validation
TERROS_WEBHOOK_SECRET=           # shared secret header value from Terros

# Qntum Roofing — Export to Qntum Portal / GHL
QNTUM_EXPORT_WEBHOOK_URL=        # destination URL for outbound export POST
QNTUM_EXPORT_SECRET=             # auth header value for outbound export
