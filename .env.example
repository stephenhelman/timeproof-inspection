# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://app.scopereports.com

# Resend (email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# App
# Used for: report share links (/summary/[uuid]), business card links (/card/[repId]),
# PDF report links, and outbound webhook callback references.
# Local dev: http://localhost:3000  |  Production: https://app.scopereports.com
NEXT_PUBLIC_APP_URL=https://app.scopereports.com

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# GoHighLevel
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_WEBHOOK_SECRET=

# ── GHL Pipeline IDs ─────────────────────────────────────────
# Get from GHL → Settings → Pipelines → click pipeline → copy ID from URL
GHL_PIPELINE_ROOF_GUIDE=
GHL_PIPELINE_INSPECTION=
GHL_PIPELINE_REVIVAL=

# ── GHL Stage IDs ────────────────────────────────────────────
# Get from GHL API: GET /opportunities/pipelines
# Or ask GHL support for stage IDs — not visible in UI directly

# Roof Guide Funnel:
GHL_STAGE_GUIDE_SUBMITTED=
GHL_STAGE_NURTURE_ACTIVE=
GHL_STAGE_ZIP_REVIEW=
GHL_STAGE_QUALIFIED=
GHL_STAGE_BOOKED=

# Inspection Pipeline:
GHL_STAGE_NEW_LEAD=
GHL_STAGE_QUALIFYING=
GHL_STAGE_BOOKING=
GHL_STAGE_APPOINTMENT_SET=
GHL_STAGE_EN_ROUTE=           # optional — move opp stage when rep dispatches
GHL_STAGE_IN_PROGRESS=        # optional — move opp stage when rep arrives
GHL_STAGE_DEMO_NOT_SOLD=
GHL_STAGE_NO_SHOW=
GHL_STAGE_DEAD=
GHL_STAGE_SOLD=
GHL_STAGE_PENDING_SOLD=              # pending manager approval — set on SOLD dispo, before confirm-sold
GHL_STAGE_MANAGER_REVIEW=           # optional — move opp stage on escalation

# Revival Pipeline:
GHL_STAGE_FOLLOW_UP_ACTIVE=
GHL_STAGE_RESCHEDULING=
GHL_STAGE_FINANCE_DISCOVERY=
GHL_STAGE_RE_QUALIFIED=
GHL_STAGE_EXHAUSTED=

# ── GHL Custom Field IDs ─────────────────────────────────────
# Get from GHL → Settings → Custom Fields → hover field → copy ID
# These are UUIDs, not field names
GHL_FIELD_SR_SOURCE=
GHL_FIELD_SR_BOT_STAGE=
GHL_FIELD_LEAD_ID=
GHL_FIELD_REP=
GHL_FIELD_ROOF_TYPE=
GHL_FIELD_ROOF_AGE=
GHL_FIELD_ISSUES_NOTICED=
GHL_FIELD_LAST_INSPECTED=
GHL_FIELD_SR_APPOINTMENT_DATETIME=   # datetime field written on booking confirmation
GHL_FIELD_SR_PREVIOUS_CONTEXT=       # contact field for bot context summary
GHL_FIELD_OPP_SR_INSPECTION_ID=      # opp field for sr_inspection_id
GHL_FIELD_OPP_SR_PIPELINE_CONTEXT=   # opp field for pipeline context JSON
GHL_FIELD_OPP_SR_APPOINTMENT_ID=     # opp field for sr_appointment_id (new)

# Anthropic (Claude bot)
ANTHROPIC_API_KEY=sk-ant-...

# Qntum Roofing — Terros inbound webhook validation
TERROS_WEBHOOK_SECRET=           # shared secret header value from Terros

# Qntum Roofing — Export to Qntum Portal / GHL
QNTUM_EXPORT_WEBHOOK_URL=        # destination URL for outbound export POST
QNTUM_EXPORT_SECRET=             # auth header value for outbound export

# Phase 2 — Marketing funnel (scopereports.com)
# Public-facing marketing domain (used in emails and cross-domain links)
NEXT_PUBLIC_MARKETING_URL=https://scopereports.com
# How long a qualify session JWT stays valid (minutes). Increasing this extends
# the window a homeowner has to complete the form after the ZIP gate passes.
QUALIFY_TOKEN_EXPIRY_MINUTES=15
# GHL_LEADS_WEBHOOK_URL — removed.
# Server now calls GHL API directly via ghl-contacts.ts.
# See createGhlOpportunity() and upsertGhlContact().

# Phase 3 — Facebook Lead Ads via GHL
# GHL user ID to assign as the default owner for all Facebook-sourced leads.
# Find in GHL → Settings → My Staff → click user → copy ID from URL.
GHL_DEFAULT_ASSIGNEE_ID=
# GHL_SR_LEAD_OBJECT_ID — the object KEY, not the schema/object ID.
# Format: custom_objects.{internal_name}
# Example: custom_objects.sr_lead
# Found in GHL → Settings → Custom Objects → SR Lead → "Object Key" or "Internal Name" field.
# All properties must be created in GHL before this is set (see PHASE_3_NOTES.md).
GHL_SR_LEAD_OBJECT_ID=

# Phase 4 — SMS Bots (qualify / book / revival)
# GHL calendar ID used for free-slot availability checks before offering times.
# Find in GHL → Calendars → click calendar → copy ID from URL.
GHL_CALENDAR_ID=
# Timezone for all bot scheduling. Must be a valid IANA timezone string.
BOT_TIMEZONE=America/Denver
# GHL phone number used for qualify / book / reschedule pipeline (Tier 1 SMS).
GHL_PRIMARY_NUMBER=
# GHL phone number used for revival / finance pipeline.
GHL_RECOVERY_NUMBER=

# Phase 5 — Marketing site (scopereports.com)
# URL of the main Qntum Roofing website — linked from header/footer "Powered by Qntum Roofing"
NEXT_PUBLIC_QNTUM_WEBSITE_URL=https://qntum.com
# Max number of photos returned by GET /api/gallery and shown in the gallery page
NEXT_PUBLIC_GALLERY_PHOTO_LIMIT=20
# Google Places API key for future dynamic review pull (optional at launch — start hardcoded)
GOOGLE_PLACES_API_KEY=
