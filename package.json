{
  "name": "timeproof-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prompts:compile": "node scripts/compile-prompts.mjs",
    "prebuild": "node scripts/compile-prompts.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "seed:user": "node --env-file=.env.local scripts/seed-user.js",
    "seed:admin": "node --env-file=.env.local --experimental-strip-types scripts/seed-admin.ts",
    "bot:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --import ./harness/load-ts.mjs harness/bot-test.ts",
    "conversation:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --import ./harness/load-ts.mjs harness/conversation-seam-test.ts",
    "nurture:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --import ./harness/load-ts.mjs harness/nurture-live-route-test.ts",
    "alex:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --import ./harness/load-ts.mjs harness/alex-arc-live-route-test.ts",
    "jordan:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --import ./harness/load-ts.mjs harness/jordan-live-route-test.ts",
    "cache:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --import ./harness/load-ts.mjs harness/cache-verify.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.1024.0",
    "@aws-sdk/s3-request-presigner": "^3.1024.0",
    "@gohighlevel/api-client": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.3.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "ghl-sdk": "^1.2.0",
    "lucide-react": "^1.8.0",
    "next": "14.2.35",
    "next-auth": "^5.0.0-beta.30",
    "papaparse": "^5.5.3",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.10.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18",
    "typescript": "^5"
  }
}
