generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  INSPECTION_SCHEDULED
  EN_ROUTE
  INSPECTION_IN_PROGRESS
  INSPECTION_COMPLETE
  QUOTED
  PENDING_SOLD_CONFIRMATION
  SOLD
  DENIED
  NO_SHOW
  DEMO_NOT_SOLD
  REVIVAL_PENDING
  REVIVAL_RECOVERED
  DEAD
  OUT_OF_AREA
  WAITLIST
}

enum RevivalStatus {
  PENDING
  ATTEMPTED
  CONNECTED
  NOT_INTERESTED
  NO_ANSWER
}

enum RevivalOutcome {
  RECOVERED
  REVIEW_REQUESTED
  REFERRAL_GIVEN
  DEAD
}

enum UserRole {
  ADMIN
  REGIONAL
  SALES_MANAGER
  SETTER_MANAGER
  SETTER
  REP
}

enum AppointmentStatus {
  SCHEDULED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AppointmentSource {
  ALEX
  JORDAN
  REP
}

enum TaskType {
  SETTER_FOLLOWUP
  REP_FOLLOWUP
  FINANCE_REVIEW
  ZIP_REVIEW
  MANUAL_BOOKING
  ESCALATION
}

enum TaskStatus {
  PENDING
  RESOLVED
}

enum TaskSource {
  BOT
  GHL_WEBHOOK
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  emailVerified       DateTime?
  name                String?
  image               String?
  password            String?         // bcrypt hashed — set via scripts/seed-user.js
  createdAt           DateTime        @default(now())

  // Business card fields
  phone               String?
  area                String?         // city/region the rep services
  profileImageUrl     String?         // R2 object URL for card profile photo
  cardShowPhone       Boolean         @default(true)
  cardShowEmail       Boolean         @default(true)
  cardShowArea        Boolean         @default(true)
  cardShowReportLink  Boolean         @default(true)
  cardShowQr          Boolean         @default(true)
  cardShowProfileImage Boolean        @default(true)

  ghlContactId   String?         // GHL contact ID for rep SMS notifications via bot-engine
  ghlUserId      String?         @unique // GHL user ID for task assignment and rep calendar
  repSlug        String?         @unique // URL-safe slug for door approach QR codes e.g. "stephen-helman"
  staffOnly      Boolean         @default(false) // staff accounts with no login required

  role           UserRole        @default(REP)
  isActive       Boolean         @default(true)
  managerId      String?
  manager        User?           @relation("UserManager", fields: [managerId], references: [id])
  reports        User[]          @relation("UserManager")

  inspections    Inspection[]
  sessions       Session[]
  accounts       Account[]
  trustedDevices TrustedDevice[]
  leads          Lead[]          @relation("LeadAssigned")
  setLeads       Lead[]          @relation("LeadSetter")
  appointments   Appointment[]
  tasks          Task[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lead {
  id                   String          @id @default(cuid())
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  customerName         String
  streetAddress        String
  city                 String
  state                String
  zip                  String
  phone                String?
  email                String?
  assignedTech         String?
  createdBy            String?
  source               String          @default("manual")
  externalId           String?
  highestEstimateValue Float?
  priorQuoteUrl        String?
  eagleViewUrl         String?
  status               LeadStatus      @default(NEW)
  revivalStatus        RevivalStatus?
  revivalOutcome       RevivalOutcome?
  revivalNotes         String?
  revivalCalledAt      DateTime?
  revivalCalledBy      String?
  jobCompletionDate    DateTime?
  assignedUserId       String?
  assignedUser         User?           @relation("LeadAssigned", fields: [assignedUserId], references: [id])
  setterUserId         String?
  setterUser           User?           @relation("LeadSetter", fields: [setterUserId], references: [id])
  ghlContactId         String?         // GHL contact ID written back after export
  facebookLeadId       String?         // Facebook Lead Ad form submission ID
  qualifyToken         String?         // JWT sent in tier_1 SMS; used to pre-auth /qualify
  qualifyTokenExp      DateTime?       // Token expiry (48hr from issuance)

  // Qualify funnel fields — populated when lead enters via scopereports.com
  roofAge              String?
  knownIssues          Json?
  lastInspected        String?
  bestTime             String?
  decisionMakerHome    String?
  qualifyCompletedAt   DateTime?
  sourceZip            String?         // ZIP entered in gate form (may differ from address zip after rep update)
  sourceTier           String?         // 'primary' | 'secondary' | 'out_of_area'

  // SMS consent — TCPA compliance
  smsConsentAt         DateTime?
  smsConsentIp         String?
  smsConsentText       String?

  // Bot state
  lastBotMessage       DateTime?
  lastBotType          String?
  botOptedOut          Boolean   @default(false)
  calendarConflict     Boolean   @default(false)

  // Dispo fields — written by DispoModal after demo
  dispoDecisionMakerPresent Boolean?
  dispoPrimaryObjection     String?
  dispoNotes                String?
  rescheduleReason          String?
  lenderAttempted           Boolean?
  // §8 dispo nuance ("how it happened"), scoped by the lead's current mission
  // stage. The durable local mirror of the GHL sr_dispo_context contact field:
  // written by the dispo handler, read by the Jordan handlers as the fallback
  // when the webhook customData doesn't carry it (pre-Sprint 8). Vocabulary is
  // locked in src/lib/bot-v2/dispo-context.ts.
  srDispoContext            String?
  // §G guide nuance carried from the Roof Guide pipeline into Inspection/qualify
  // (Sprint 9 Part G). Durable local mirror of the GHL sr_guide_context contact
  // field. "zip_cleared" when a held expansion-zone lead was manually approved;
  // empty for an in-area lead. Qualify reads it to pick the opener.
  srGuideContext            String?

  // SOLD confirmation
  pendingSoldAt             DateTime?
  pendingSoldConfirmedBy    String?

  // Nurture / door / card attribution fields
  roofType                  String?  // Shingle / Flat / Both — from guide form
  issuesNoticed             String?  // Comma-separated checkbox values from guide form
  rep                       String?  // Rep slug (stephen/adam/etc.) for door/card attribution
  guideToken                String?  // JWT token for personalized guide URL access
  guideUnlockedAt           DateTime? // When they submitted the guide form
  guideSource               String?  // 'facebook-guide' | 'door' | 'card'
  guideSlug                 String?  @unique // human-readable URL slug e.g. "stephen-elpaso-a3f2"

  // Contact form — populated when lead enters via /contact page
  contactFormMessage        String?  @db.Text

  ghlRecordId               String?   // GHL SR Lead custom object record ID
  ghlOpportunityId          String?   // GHL opportunity ID for stage moves

  // Bot-collected address — set by book bot when homeowner provides it via SMS
  address                   String?

  inspections          Inspection[]
  notes                LeadNote[]
  srLead               SrLead?
  appointments         Appointment[]
  tasks                Task[]
}

model SrLead {
  id              String    @id @default(cuid())
  leadId          String    @unique
  ghlContactId    String    @unique
  ghlRecordId     String?

  srLeadId        String
  srTier          String
  srZone          String
  srStatus        String
  srQualifyStatus String
  srBotStage      String
  srAppointmentAt DateTime?
  srSource        String
  srOptedOut      Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lead            Lead      @relation(fields: [leadId], references: [id])

  @@index([ghlContactId])
  @@index([leadId])
}

model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  phase      String?  // "opener" | "phase_1" | "phase_2" | "phase_3" | "phase_4" | "phase_5" | "general"
  authorName String?
  authorId   String?
  createdAt  DateTime @default(now())

  @@index([leadId])
}

model Inspection {
  id                String        @id @default(cuid())
  reportUuid        String        @unique @default(cuid())
  userId            String?
  user              User?         @relation(fields: [userId], references: [id])
  // Customer info — denormalized from lead at inspection creation time
  customerName      String?
  address           String?
  phone             String?
  email             String?

  leadId            String?
  lead              Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  repName           String?
  date              DateTime      @default(now())
  status            String        @default("draft")

  // Discovery (legacy — preserved for existing data)
  ownershipLength   String?
  previousRoofWork  Boolean?
  previousRoofWhen  String?
  previousRoofWhy   String?
  previousRoofNotes String?
  previousWork      Json?
  activeLeaks       Boolean?
  leakLocation      String?
  issues            Json?
  thingsToKnow      String?
  allDecisionMakers Boolean?
  priorities        String[]

  // Findings — legacy (preserved for existing data)
  findings          Json?
  findingsNotes     String?

  // Production (legacy — preserved for existing data)
  productionNotes   String?
  gateCode          String?
  hasPets           Boolean?
  accessIssues      String?
  hoaRestrictions   Boolean?
  hoaDetails        String?
  colorSelected     String?
  specialRequests   String?
  followUpNotes     String?

  // Qntum intake form — Pass 1 (Before)
  northStar              String?   // Why are we here
  focusDrivers           String?   // What moves the needle
  timeInHome             String?
  yearBuilt              String?
  ageOfRoof              String?
  lastReplacedBy         String?
  pastRepairs            String?
  otherProjects          String?
  hoaPresent             Boolean?
  hoaName                String?
  issuesConcerns         String?
  issueDuration          String?
  issueImpact            String?
  rootCauseBeliefBefore  String?   // their belief before inspection
  triggerMoment          String?
  priorMeetingHad        Boolean?
  priorMeetingWho        String?
  priorMeetingRecommended String?
  priorMeetingWhyNotFixed String?
  noPriorMeetingReason   String?
  winDefinition          String?   // "short" | "long"
  personalFamily         String?
  personalOccupation     String?
  personalRecreation     String?
  personalIdentity       String?
  decisionMakers         Boolean?
  decisionMakersWho      String?

  // GHL integration
  ghlEventId             String?   // GHL calendar event ID written on booking confirmation

  // Appointment fields (new — structured JSON storage for wizard passes)
  intakePass1              Json?      // pre-diagnosis homeowner awareness
  warningSignResponses     Json?      // warning sign checklist responses
  aiDiagnosisDescription   String?    // human-readable Claude output
  aiDiagnosisStructured    Json?      // machine-readable Claude output for Jordan
  aiGeneratedAt            DateTime?  // when the Claude call fired
  intakePass2              Json?      // post-diagnosis homeowner admission

  setterName             String?

  // Intake form — Pass 2 (After)
  problemAwarenessBefore String?   // locked after Pass 1 complete
  problemAwarenessAfter  String?   // unlocked after Warning Signs complete
  intakePass1Complete    Boolean   @default(false)
  intakePass2Complete    Boolean   @default(false)

  // Rep internal notes — never shown on report
  repNotes               String?

  // Diagnosis — stored as JSON array of finding objects
  diagnosis              Json?

  // Warning signs covered
  warningSignsCovered    String[]  @default([])

  // Dispatch / arrival tracking
  dispatchedAt           DateTime?
  arrivedAt              DateTime?

  // Post-demo outcome
  outcome                String?   // SOLD | PENDING_SOLD_CONFIRMATION | DEMO_NOT_SOLD | DENIED | NO_SHOW | DEAD | QUOTED | REVIVAL_PENDING

  // Export tracking
  qntumExportedAt        DateTime?

  photos            Photo[]
  reportVisits      ReportVisit[]
  appointment       Appointment?
  tasks             Task[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Appointment {
  id                 String            @id @default(cuid())
  leadId             String
  inspectionId       String            @unique
  assignedUserId     String
  scheduledAt        DateTime
  status             AppointmentStatus @default(SCHEDULED)
  createdBy          AppointmentSource
  ghlCalendarEventId String?
  ghlOpportunityId   String?
  ghlSyncPending     Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  lead               Lead              @relation(fields: [leadId], references: [id])
  inspection         Inspection        @relation(fields: [inspectionId], references: [id])
  assignedUser       User              @relation(fields: [assignedUserId], references: [id])
}

model Task {
  id                String      @id @default(cuid())
  leadId            String
  inspectionId      String?
  assignedUserId    String
  type              TaskType
  status            TaskStatus  @default(PENDING)
  context           String
  outcome           String?
  availableOutcomes String[]
  createdBy         TaskSource
  createdAt         DateTime    @default(now())
  resolvedAt        DateTime?

  lead              Lead        @relation(fields: [leadId], references: [id])
  inspection        Inspection? @relation(fields: [inspectionId], references: [id])
  assignedUser      User        @relation(fields: [assignedUserId], references: [id])
}

model Photo {
  id               String     @id @default(cuid())
  inspectionId     String
  inspection       Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  photoNumber      Int
  r2Key            String
  r2Url            String
  damageTags       String[]
  description      String?
  photoSection     String     @default("roof")  // "roof" | "attic"
  zone             String?    // roof zone or attic zone label
  galleryEligible  Boolean    @default(false)
  cityArea         String?    // "East El Paso" | "Las Cruces" | etc — rep sets in wizard
  createdAt        DateTime   @default(now())

  photoEngagements PhotoEngagement[]
}

model ReportVisit {
  id           String        @id @default(cuid())
  inspectionId String
  inspection   Inspection    @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  visitedAt    DateTime      @default(now())
  device       String?
  userAgent    String?
  visitNumber  Int
  sections     SectionView[]
  photoEngagements PhotoEngagement[]
}

model SectionView {
  id            String      @id @default(cuid())
  visitId       String
  visit         ReportVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  sectionKey    String
  secondsViewed Int         @default(0)
}

model PhotoEngagement {
  id            String      @id @default(cuid())
  reportVisitId String
  photoId       String
  dwellMs       Int
  slideIndex    Int
  createdAt     DateTime    @default(now())

  reportVisit   ReportVisit @relation(fields: [reportVisitId], references: [id], onDelete: Cascade)
  photo         Photo       @relation(fields: [photoId], references: [id], onDelete: Cascade)
}

model RegistrationCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String   // bcrypt hashed 6-digit code — never store plaintext
  expiresAt DateTime // 30 minutes from creation
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  purpose   String   @default("registration") // registration | forgot-password | 2fa | email-change
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([email, purpose])
}

model TrustedDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken String   @unique
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())
  expiresAt   DateTime // 30 days from creation

  @@index([userId])
  @@index([deviceToken])
}

model BotThread {
  id            String    @id @default(cuid())
  ghlContactId  String
  botType       String    // 'qualify' | 'book' | 'revival' | 'reschedule' | 'finance'
  messages      Json      @default("[]")
  metadata      Json?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([ghlContactId, botType])
}

// The per-contact durable "brain" — ONE row per contact, living above the phase
// boundaries (ARCHITECTURE.md §7). Read/written by every bot across all phases.
// NOT the transcript (that stays in BotThread); this holds the STRUCTURED state
// that must survive a phase handoff.
//
// AUTHORSHIP is load-bearing and enforced in code (lib/conversation +
// lib/bot-v2/field-authorship): MODEL-authored fields are written from the
// contract's `state` block each turn; SYSTEM-authored fields are written only by
// app code and are injected into the prompt as read-only context. The model can
// never write a SYSTEM-authored field — applyModelStateDelta won't accept it.
model Conversation {
  id              String   @id @default(cuid())
  ghlContactId    String   @unique          // the cross-phase key
  leadId          String?                    // FK to Lead, nullable for early-funnel

  // ─── ROUTING / PHASE (SYSTEM-authored — mirrors srBotStage) ───
  currentPhase    String                     // nurture|qualify|book|revival|reschedule|finance|silent
  phaseHistory    Json     @default("[]")    // [{phase, enteredAt, exitSignal}] — the journey

  // ─── NEPQ STATE (MODEL-authored) ───
  nepqPhase           String?                // connection|situation|problem|consequence|commitment
  motivation          Json    @default("[]") // string[]
  urgency             String?                // none|low|medium|high
  consequenceSurfaced Boolean @default(false)

  // ─── GATES (MODEL-authored) ───
  gateProblem         Boolean @default(false)
  gateDecisionMaker   Boolean @default(false)
  // NOTE: gate "consequence" == consequenceSurfaced. There is intentionally NO
  //       separate gateConsequence field — qualify gate logic references
  //       consequenceSurfaced. One field, no duplication (ARCHITECTURE §7).

  // ─── OBJECTIONS (MODEL-authored) ───
  objectionsSurfaced  Json    @default("[]") // [{family, surfaceForm, wasReal, resolved, turnRef}]
  primaryObjection    String?

  // ─── DECISION MAKERS / LOGISTICS (MODEL-authored) ───
  decisionMakers      Json    @default("[]") // [{role, present, sharesConcern}]
  timePrefs           Json?                  // {days, windows}
  address             String?                // collected by Book; mirrored to Lead
  selectedSlot        String?                // the slot the homeowner picked, emitted by Book on BOOKED
                                             //   and Jordan on REBOOKED; handed to the existing confirm
                                             //   path. Model-authored (ARCHITECTURE §5/§7).

  // ─── SOURCE (SYSTEM-authored, set at lead creation) ───
  sourceType          String?                // guide | inspection
  sourceChannel       String?                // rep_door | rep_card | organic   (advisory only)
  funnelConcerns      Json?                  // self-selected items from guide funnel (damage signs, roof age, etc.)
  repName             String?

  // ─── RECOVERY CONTEXT (SYSTEM-authored from DB/GHL — Jordan reads) ───
  consequenceLikelySurfaced Boolean?         // derived from rep notes — reschedule calibration
  affordabilityIsReal       Boolean @default(false) // set true on credit/finance fail — finance override
  rescheduleSubCase         String?          // no_show | porched_door | porched_soft | simple
  daysSinceAppointment      Int?

  // ─── HEAT (SYSTEM-authored — tier selection) ───
  heatState         String   @default("cold") // cold | warming  (bidirectional via cooldown)
  heatLastInbound   DateTime?                  // timestamp of lead's last INBOUND — drives cooldown
  heatPeakReached   Boolean  @default(false)   // ever warmed? informs re-approach tone, never resets

  // ─── BOOKING / ZIP (SYSTEM-authored — Sprint 9 timed-stage hygiene) ───
  // Cumulative count of UNANSWERED booking nudges across the whole booking saga
  // (never reset on re-stall — the serial-non-committer signal, Part B). Exhaustion
  // is bookingPendingAttempts >= N, lifecycle-routed (Part D).
  bookingPendingAttempts Int     @default(0)
  // True once an expansion-zone guide lead was held for manual zip review and then
  // cleared (Part G). Drives the qualify "good news, we service your area" opener.
  zipWasHeld             Boolean @default(false)

  // ─── HANDOFF SUMMARY (MODEL-authored, structured) ───
  summary           Json?                      // {situation, problem, consequence, openObjection, nextStep}

  // ─── META ───
  lastSignal        String?
  lastModelTier     String?                    // haiku | sonnet — telemetry for tuning
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ghlContactId])
}

model SlotLock {
  id        String   @id @default(cuid())
  date      DateTime
  time      String
  label     String?  // verbatim slot label e.g. "Thursday, June 5 at 9:00 am"
  zone      String
  leadId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([date, zone])
  @@index([expiresAt])
}

model WebhookLog {
  id               String   @id @default(cuid())
  source           String   // e.g. "terros" | "ghl_facebook" | "ghl_bot_qualify"
  payload          Json
  normalized       Json?    // normalized payload shape written alongside raw
  status           String   // "success" | "error"
  errorMessage     String?
  leadId           String?  // set if a lead was created
  idempotencyKey   String?  @unique
  createdAt        DateTime @default(now())

  @@index([source])
  @@index([createdAt])
}
