generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  INSPECTION_SCHEDULED
  INSPECTION_COMPLETE
  QUOTED
  SOLD
  DENIED
  NO_SHOW
  DEMO_NOT_SOLD
  REVIVAL_PENDING
  REVIVAL_RECOVERED
  DEAD
}

enum RevivalStatus {
  PENDING
  ATTEMPTED
  CONNECTED
  NOT_INTERESTED
  NO_ANSWER
}

enum RevivalOutcome {
  RECOVERED
  REVIEW_REQUESTED
  REFERRAL_GIVEN
  DEAD
}

enum UserRole {
  ADMIN
  REP
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  emailVerified       DateTime?
  name                String?
  image               String?
  password            String?         // bcrypt hashed — set via scripts/seed-user.js
  createdAt           DateTime        @default(now())

  // Business card fields
  phone               String?
  area                String?         // city/region the rep services
  profileImageUrl     String?         // R2 object URL for card profile photo
  cardShowPhone       Boolean         @default(true)
  cardShowEmail       Boolean         @default(true)
  cardShowArea        Boolean         @default(true)
  cardShowReportLink  Boolean         @default(true)
  cardShowQr          Boolean         @default(true)
  cardShowProfileImage Boolean        @default(true)

  role           UserRole        @default(ADMIN)

  inspections    Inspection[]
  sessions       Session[]
  accounts       Account[]
  trustedDevices TrustedDevice[]
  leads          Lead[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Lead {
  id                   String          @id @default(cuid())
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  customerName         String
  streetAddress        String
  city                 String
  state                String
  zip                  String
  phone                String?
  email                String?
  assignedTech         String?
  createdBy            String?
  source               String          @default("manual")
  externalId           String?
  highestEstimateValue Float?
  priorQuoteUrl        String?
  eagleViewUrl         String?
  status               LeadStatus      @default(NEW)
  revivalStatus        RevivalStatus?
  revivalOutcome       RevivalOutcome?
  revivalNotes         String?
  revivalCalledAt      DateTime?
  revivalCalledBy      String?
  appointmentDate      DateTime?
  jobCompletionDate    DateTime?
  assignedUserId       String?
  assignedUser         User?           @relation(fields: [assignedUserId], references: [id])
  ghlContactId         String?         // GHL contact ID written back after export
  inspections          Inspection[]
  notes                LeadNote[]
}

model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  phase      String?  // "opener" | "phase_1" | "phase_2" | "phase_3" | "phase_4" | "phase_5" | "general"
  authorName String?
  authorId   String?
  createdAt  DateTime @default(now())

  @@index([leadId])
}

model Inspection {
  id                String        @id @default(cuid())
  reportUuid        String        @unique @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  // Customer info — denormalized from lead at inspection creation time
  customerName      String?
  address           String?
  phone             String?
  email             String?
  // PRESERVED — not active in Qntum build
  // heardAboutUs   String?

  leadId            String?
  lead              Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  repName           String?
  date              DateTime      @default(now())
  status            String        @default("draft")

  // Discovery (legacy — preserved for existing data)
  ownershipLength   String?
  previousRoofWork  Boolean?
  previousRoofWhen  String?
  previousRoofWhy   String?
  previousRoofNotes String?
  previousWork      Json?
  activeLeaks       Boolean?
  leakLocation      String?
  issues            Json?
  thingsToKnow      String?
  allDecisionMakers Boolean?
  priorities        String[]

  // Findings — legacy (preserved for existing data)
  findings          Json?
  findingsNotes     String?

  // Production (legacy — preserved for existing data)
  productionNotes   String?
  gateCode          String?
  hasPets           Boolean?
  accessIssues      String?
  hoaRestrictions   Boolean?
  hoaDetails        String?
  colorSelected     String?
  specialRequests   String?
  followUpNotes     String?

  // Qntum intake form — Pass 1 (Before)
  northStar              String?   // Why are we here
  focusDrivers           String?   // What moves the needle
  timeInHome             String?
  yearBuilt              String?
  ageOfRoof              String?
  lastReplacedBy         String?
  pastRepairs            String?
  otherProjects          String?
  hoaPresent             Boolean?
  hoaName                String?
  issuesConcerns         String?
  issueDuration          String?
  issueImpact            String?
  rootCauseBeliefBefore  String?   // their belief before inspection
  triggerMoment          String?
  priorMeetingHad        Boolean?
  priorMeetingWho        String?
  priorMeetingRecommended String?
  priorMeetingWhyNotFixed String?
  noPriorMeetingReason   String?
  winDefinition          String?   // "short" | "long"
  personalFamily         String?
  personalOccupation     String?
  personalRecreation     String?
  personalIdentity       String?
  decisionMakers         Boolean?
  decisionMakersWho      String?

  // Appointment
  appointmentAt          DateTime?
  setterName             String?

  // Intake form — Pass 2 (After)
  problemAwarenessBefore String?   // locked after Pass 1 complete
  problemAwarenessAfter  String?   // unlocked after Warning Signs complete
  intakePass1Complete    Boolean   @default(false)
  intakePass2Complete    Boolean   @default(false)

  // Rep internal notes — never shown on report
  repNotes               String?

  // Diagnosis — stored as JSON array of finding objects
  diagnosis              Json?

  // Warning signs covered
  warningSignsCovered    String[]  @default([])

  // Export tracking
  qntumExportedAt        DateTime?

  structures        Structure[]
  photos            Photo[]
  // PRESERVED — not active in Qntum build
  packages          Package[]
  // PRESERVED — not active in Qntum build
  quote             Quote?
  reportVisits      ReportVisit[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// PRESERVED — not active in Qntum build
model Structure {
  id            String     @id @default(cuid())
  inspectionId  String
  inspection    Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  name          String
  inScope       Boolean    @default(true)
  order         Int        @default(0)

  // PRESERVED — not active in Qntum build
  // entryMode  String  @default("simple")

  // Measurement totals — PRESERVED — not active in Qntum build
  // pitch      String?
  // sqft       Float?
  // ridge      Float?
  // hip        Float?
  // valley     Float?
  // rake       Float?
  // eave       Float?
  // flashing   Float?
  // stepFlashing Float?
  // parapets   Float?
  // other      Float?

  // Penetration counts — always structure-level
  pipeBoots     Int?
  skylights     Int?
  chimneys      Int?
  boxVents      Int?
  turbines      Int?
  atticFans     Int?

  facets        Facet[]
}

// PRESERVED — not active in Qntum build
model Facet {
  id          String    @id @default(cuid())
  structureId String
  structure   Structure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  order       Int       @default(0)
  name        String    @default("Facet")

  // PRESERVED — not active in Qntum build
  // pitch        String?
  // sqft         Float?
  // ridge        Float?
  // hip          Float?
  // valley       Float?
  // rake         Float?
  // eave         Float?
  // flashing     Float?
  // stepFlashing Float?
  // parapets     Float?
  // other        Float?
}

model Photo {
  id            String     @id @default(cuid())
  inspectionId  String
  inspection    Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  photoNumber   Int
  r2Key         String
  r2Url         String
  damageTags    String[]
  description   String?
  photoSection  String     @default("roof")  // "roof" | "attic"
  createdAt     DateTime   @default(now())
}

// PRESERVED — not active in Qntum build
model Package {
  id            String     @id @default(cuid())
  inspectionId  String
  inspection    Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  name          String
  basePrice     Float      @default(0)
  nationalPromo Boolean    @default(false)
  localPromo    Boolean    @default(false)
  fsp           Boolean    @default(false)
  nisi          Float?
  recommended   Boolean    @default(false)
  order         Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// PRESERVED — not active in Qntum build
model Quote {
  id             String     @id @default(cuid())
  inspectionId   String     @unique
  inspection     Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  basePrice      Float?
  nationalPromo  Boolean    @default(false)
  localPromo     Boolean    @default(false)
  fsp            Boolean    @default(false)
  nisi           Float?
  commissionRate Float?
  commission     Float?
  estMonthly     Float?
}

model ReportVisit {
  id           String        @id @default(cuid())
  inspectionId String
  inspection   Inspection    @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  visitedAt    DateTime      @default(now())
  device       String?
  userAgent    String?
  visitNumber  Int
  sections     SectionView[]
}

model SectionView {
  id            String      @id @default(cuid())
  visitId       String
  visit         ReportVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  sectionKey    String
  secondsViewed Int         @default(0)
}

model RegistrationCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String   // bcrypt hashed 6-digit code — never store plaintext
  expiresAt DateTime // 30 minutes from creation
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  purpose   String   @default("registration") // registration | forgot-password | 2fa | email-change
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([email, purpose])
}

model TrustedDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken String   @unique
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())
  expiresAt   DateTime // 30 days from creation

  @@index([userId])
  @@index([deviceToken])
}

// Run after adding this model:
//   npx prisma migrate dev --name add_bot_thread
model BotThread {
  id        String   @id @default(cuid())
  contactId String   @unique
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
